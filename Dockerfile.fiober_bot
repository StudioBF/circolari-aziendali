# Dockerfile.bot
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Copy the script
COPY telegram_publisher.py /app/

# Install dependencies (only if you have a requirements.txt, otherwise manually or stick to standard lib)
# Since the script uses only standard library (urllib, json, time, ssl, sys, os), no pip install needed.
# If you add external libs later, uncomment the following:
# COPY requirements.txt .
# RUN pip install --no-cache-dir -r requirements.txt

# Run the script with unbuffered output to see logs in real-time
CMD ["python", "-u", "telegram_publisher.py"]
